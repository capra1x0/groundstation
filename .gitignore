.env
.env.*
!.env.example

# --- ESP32 firmware (PlatformIO, later) ---
.pio/

# --- Editors ---
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# --- OS ---
.DS_Store
Thumbs.db
